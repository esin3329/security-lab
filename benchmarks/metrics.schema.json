{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://security-lab.local/schemas/benchmark-run.schema.json",
  "title": "security-lab 벤치마크 실행 로그 스키마 (MVP)",
  "description": "결측 없는 8지표가 확정된 실행 1회분만 JSONL(한 줄 1 객체, append-only)로 저장한다. 형식 검증은 실측·ground-truth 확정의 증거가 아니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "timestamp",
    "tool",
    "tool_version",
    "target",
    "time_limit_min",
    "repeat_index",
    "metrics"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])",
      "description": "실행 고유 ID (예: 2026-10-12-juice-shop-strix-001)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)(?![\\s\\S])",
      "description": "유효한 실행 시작 시각 (RFC 3339, UTC Z 또는 +00:00). format 검증기도 함께 적용한다."
    },
    "tool": {
      "type": "string",
      "enum": ["strix", "manual"],
      "description": "MVP 측정 대상. artex-ko, rea는 Phase 2 이후 추가."
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:alpha|beta|rc)\\.[0-9]+)?|[0-9a-f]{40}|(?:[a-z0-9][a-z0-9.-]*(?::[0-9]+)?(?:/[a-z0-9][a-z0-9._-]*)*@)?sha256:[0-9a-f]{64})(?![\\s\\S])",
      "description": "실제 확인된 X.Y.Z/vX.Y.Z 릴리스(선택: -alpha.N/-beta.N/-rc.N), 전체 소문자 Git SHA 40자리, sha256:64자리 또는 태그 없는 image@sha256:64자리. 빈 값·latest/main/stable 등 가변 별칭·축약 해시는 거부. 형식만으로 버전의 실재 여부를 증명하지 않는다."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "host_port"],
      "properties": {
        "name": { "type": "string", "const": "juice-shop", "description": "MVP의 승인된 단일 웹 대상" },
        "host_port": {
          "type": "string",
          "enum": ["juice-shop:3000", "127.0.0.1:3000", "localhost:3000"],
          "description": "승인된 allowlist 3개 중 정확히 하나. URL·경로·대소문자/공백 변형은 거부."
        }
      }
    },
    "time_limit_min": {
      "type": "integer",
      "const": 15,
      "description": "필수 대상 작업 상한 15분(900초). 누락 시 기본값을 채우지 않는다."
    },
    "repeat_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "3회 반복 중 몇 번째 실행인지"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tp",
        "fp",
        "poc_success_rate",
        "duration_sec",
        "token_cost",
        "human_interventions",
        "reproducibility",
        "explainability"
      ],
      "properties": {
        "tp": {
          "type": "integer",
          "minimum": 0,
          "description": "지표 1. True Positive 수 (ground-truth와 대조해 확정된 참 탐지)"
        },
        "fp": {
          "type": "integer",
          "minimum": 0,
          "description": "지표 2. False Positive 수 (오탐 수)"
        },
        "poc_success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "지표 3. PoC 성공률 (성공 PoC 수 / 시도 PoC 수, 0~1)"
        },
        "duration_sec": {
          "type": "number",
          "minimum": 0,
          "description": "지표 4. 실제 실행 시간 (초, 래퍼 시작~종료). 준비/정리로 900초를 넘을 수 있으므로 대상 작업 상한과 구별한다."
        },
        "token_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokens", "cost_usd"],
          "properties": {
            "tokens": { "type": "integer", "minimum": 0, "description": "지표 5a. 사용 토큰 수" },
            "cost_usd": { "type": "number", "minimum": 0, "description": "지표 5b. API 비용 (USD)" }
          }
        },
        "human_interventions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count"],
          "properties": {
            "count": { "type": "integer", "minimum": 0, "description": "지표 6a. 사람 개입 횟수" },
            "minutes": { "type": "number", "minimum": 0, "description": "지표 6b(선택). 사람 개입 시간(분)" }
          }
        },
        "reproducibility": {
          "type": "string",
          "enum": ["재현 성공", "재현 실패", "부분 재현"],
          "description": "지표 7. 재현성 (동일 조건 재실행 시 동일 결과 여부)"
        },
        "explainability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "지표 8. 설명가능성 (1~5 루브릭, reports/ 비교표 기준)"
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "관찰 메모 (한국어, 선택)"
    }
  }
}
